{
  "name": "partshub",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "pricing-worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "partshub-catalog",
